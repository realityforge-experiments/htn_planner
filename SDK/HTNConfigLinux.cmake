cmake_minimum_required(VERSION 3.25)
if(TARGET HTN::HTNFramework)
    return()
endif()
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8
   OR NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
    message(FATAL_ERROR "This HTN SDK requires Linux x86_64")
endif()
if(NOT CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang)$")
    message(FATAL_ERROR "This HTN SDK requires GCC or Clang with libstdc++")
endif()
include(CheckCXXSourceCompiles)
unset(HTN_COMPATIBLE_LIBSTDCXX CACHE) # Recheck if a consumer changes ABI flags.
check_cxx_source_compiles("
#include <string>
#if !defined(__GLIBCXX__) || _GLIBCXX_USE_CXX11_ABI != 1 || defined(_GLIBCXX_DEBUG)
#error Incompatible C++ standard library ABI
#endif
int main() { return 0; }" HTN_COMPATIBLE_LIBSTDCXX)
if(NOT HTN_COMPATIBLE_LIBSTDCXX)
    message(FATAL_ERROR "HTN requires libstdc++ with _GLIBCXX_USE_CXX11_ABI=1 and without _GLIBCXX_DEBUG")
endif()
include(CMakeFindDependencyMacro)
find_dependency(Threads)
get_filename_component(_htn_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(READ "${_htn_root}/manifest.json" _htn_manifest)
string(JSON HTN_VERSION GET "${_htn_manifest}" sdk_version)
string(JSON _htn_platform GET "${_htn_manifest}" platform)
if(NOT _htn_platform STREQUAL "linux-x86_64")
    message(FATAL_ERROR "Wrong HTN package platform: ${_htn_platform}")
endif()
set(_htn_configs ${CMAKE_CONFIGURATION_TYPES})
if(NOT _htn_configs)
    if(NOT CMAKE_BUILD_TYPE)
        message(FATAL_ERROR "Select CMAKE_BUILD_TYPE before finding HTN")
    endif()
    set(_htn_configs "${CMAKE_BUILD_TYPE}")
endif()
foreach(_component HTNFramework HTNIntegration)
    add_library(HTN::${_component} STATIC IMPORTED GLOBAL)
    set_target_properties(HTN::${_component} PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_htn_root}/include/${_component}"
        INTERFACE_COMPILE_FEATURES cxx_std_20)
endforeach()
set_property(TARGET HTN::HTNFramework PROPERTY INTERFACE_LINK_LIBRARIES "Threads::Threads;${CMAKE_DL_LIBS}")
set_property(TARGET HTN::HTNIntegration PROPERTY INTERFACE_LINK_LIBRARIES HTN::HTNFramework)
add_library(HTN::HTNRuntimeBridge SHARED IMPORTED GLOBAL)
set_target_properties(HTN::HTNRuntimeBridge PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_htn_root}/include/HTNFramework")
add_executable(HTN::HTNTranslator IMPORTED GLOBAL)
set_property(TARGET HTN::HTNTranslator PROPERTY IMPORTED_LOCATION "${_htn_root}/bin/linux-x86_64/tools/HTNTranslator")
string(JSON _count LENGTH "${_htn_manifest}" variants)
math(EXPR _last "${_count} - 1")
foreach(_config IN LISTS _htn_configs)
    string(TOUPPER "${_config}" _upper)
    if(NOT DEFINED HTN_VARIANT_${_upper})
        if(_config STREQUAL "Debug")
            set(HTN_VARIANT_${_upper} DebugInstrumented)
        elseif(_config MATCHES "^(Release|RelWithDebInfo|MinSizeRel)$")
            set(HTN_VARIANT_${_upper} ReleasePlain)
        else()
            message(FATAL_ERROR "Set HTN_VARIANT_${_upper} to an HTN manifest variant id")
        endif()
    endif()
    set(_found FALSE)
    foreach(_index RANGE ${_last})
        string(JSON _id GET "${_htn_manifest}" variants ${_index} id)
        if(NOT _id STREQUAL HTN_VARIANT_${_upper})
            continue()
        endif()
        set(_found TRUE)
        string(JSON _defs_count LENGTH "${_htn_manifest}" variants ${_index} defines)
        math(EXPR _defs_last "${_defs_count} - 1")
        set(_defs "")
        foreach(_def_index RANGE ${_defs_last})
            string(JSON _def GET "${_htn_manifest}" variants ${_index} defines ${_def_index})
            list(APPEND _defs "${_def}")
        endforeach()
        foreach(_component HTNFramework HTNIntegration HTNRuntimeBridge)
            set_property(TARGET HTN::${_component} APPEND PROPERTY IMPORTED_CONFIGURATIONS "${_config}")
            if(_component STREQUAL "HTNRuntimeBridge")
                set(_library "${_htn_root}/lib/linux-x86_64/${_id}/lib${_component}.so")
            else()
                set(_library "${_htn_root}/lib/linux-x86_64/${_id}/lib${_component}.a")
            endif()
            if(NOT EXISTS "${_library}")
                message(FATAL_ERROR "Missing HTN library: ${_library}")
            endif()
            set_property(TARGET HTN::${_component} PROPERTY IMPORTED_LOCATION_${_upper} "${_library}")
            set_property(TARGET HTN::${_component} APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS "$<$<CONFIG:${_config}>:${_defs}>")
        endforeach()
        break()
    endforeach()
    if(NOT _found)
        message(FATAL_ERROR "Unknown HTN variant: ${HTN_VARIANT_${_upper}}")
    endif()
endforeach()

function(htn_configure_target target)
    set_target_properties(${target} PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED YES
        C_STANDARD 11 C_STANDARD_REQUIRED YES)
endfunction()
